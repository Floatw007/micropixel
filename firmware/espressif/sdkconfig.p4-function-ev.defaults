# ESP32-P4-Function-EV-Board v1.5 uses a 16 MiB QIO flash and the official
# 7-inch 1024x600 EK79007 MIPI-DSI adapter.
# CONFIG_ESPTOOLPY_FLASHSIZE_32MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.p4-function-ev.csv"

# Select the Function EV board backend. It publishes display/touch, the
# ESP32-C6 Wi-Fi coprocessor and USB Serial/JTAG local control.
# CONFIG_MICROPIXEL_BOARD_METALIO_CLAW4 is not set
CONFIG_MICROPIXEL_BOARD_ESP32_P4_FUNCTION_EV_BOARD=y
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=40
CONFIG_MICROPIXEL_FUNCTION_EV_IDLE_FREQUENCY_TELEMETRY=y
CONFIG_MICROPIXEL_FUNCTION_EV_DISPLAY_IDLE_TIMEOUT_MS=30000
CONFIG_PM_PROFILING=y

# Use the board's official ESP32-C6 ESP-Hosted SDIO wiring. The component's
# FUNC_BOARD preset selects SDIO1, 4-bit/40 MHz, CLK18, CMD19, D0..D3 14..17
# and active-high coprocessor reset on GPIO54.
# CONFIG_SLAVE_IDF_TARGET_ESP32C5 is not set
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
# CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5 is not set
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
# CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE is not set
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
